# Copy to .env with mode 600. This template contains no credentials.
APP_HTTP_PORT=3001
IMAGE_TAG=main
NODE_ENV=production
NEXT_PUBLIC_EDIT_GRAPH_MODE=false
PORT=3000
NEXT_HOSTNAME=0.0.0.0
SERVER_PORT=8080
AGENT_SERVER_URL=http://127.0.0.1:8080
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
BYTEDANCE_ASR_APP_ID=
BYTEDANCE_ASR_TOKEN=
BYTEDANCE_ASR_API_KEY=
BYTEDANCE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
BYTEDANCE_ASR_MODEL_VERSION=400
BYTEDANCE_TTS_APPID=
BYTEDANCE_TTS_TOKEN=
BYTEDANCE_TTS_RESOURCE_ID=
# Inspect the server's existing Dify listener/network before choosing this URL.
# No localhost URL: Dify is outside this app container.
DIFY_BASE_URL=http://host.docker.internal:8888/v1
DIFY_CHATFLOW_API_KEY=
DIFY_API_KEY=
LOG_PATH=/tmp/ten_voice_ai_interview
LOG_STDOUT=true
WORKERS_MAX=5
WORKER_QUIT_TIMEOUT_SECONDS=60
